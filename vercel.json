{
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "https://api.testflow.com.ng/r/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://api.testflow.com.ng/api/public/:path*"
    },
    {
      "source": "/api/v1/public/:path*",
      "destination": "https://api.testflow.com.ng/api/v1/public/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}