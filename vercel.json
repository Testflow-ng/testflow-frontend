{
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "https://api.testflow.com.ng/r/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://api.testflow.com.ng/api/public/:path*"
    },
    {
      "source": "/api/v1/public/:path*",
      "destination": "https://api.testflow.com.ng/api/v1/public/:path*"
    },
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>(?!www$)[a-z0-9-]+)\\.testflow\\.com\\.ng"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|SkypeUriPreview|Pinterest|Embedly).*)"
        }
      ],
      "destination": "https://api.testflow.com.ng/api/v1/public/site/page?host=:sub.testflow.com.ng"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}